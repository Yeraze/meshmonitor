# Build stage for ARMv7 (Raspberry Pi 2/3 32-bit)
# Node.js 24 doesn't support ARMv7, so we use Node.js 22 LTS
#
# Measured locally under QEMU (16-core amd64 host, cold cache): 18m25s before
# this split, 10m44s after — a 42% cut. Verified byte-identical output: all 823
# files under dist/ hash the same as the CI-built emulated image for the same
# source. To re-measure after changing this file:
#
#   docker run --privileged --rm tonistiigi/binfmt --install linux/arm/v7
#   docker buildx create --name armv7 --driver docker-container --bootstrap
#   docker buildx build --builder armv7 --platform linux/arm/v7 \
#     -f Dockerfile.armv7 --no-cache --progress=plain --output type=cacheonly .
#
# `--progress=plain` is required: the default TUI collapses the per-step
# "#N DONE <secs>s" lines and the timings become unrecoverable.
#
# The whole builder stage used to run under QEMU, which put three expensive
# steps on an emulated CPU that did not need to be there. Vite and tsc emit
# platform-independent JavaScript: the bytes are identical whether they are
# produced on amd64 or armv7, so emulating them buys nothing and cost ~15 of the
# ~39 minutes CI was spending. Only the native modules (better-sqlite3) genuinely
# have to be built for the target.
#
# So: JS artifacts are produced natively on the build host, and the emulated
# stage does nothing but obtain an armv7 node_modules.

# ---------------------------------------------------------------------------
# Stage 1 (NATIVE): produce dist/ on the builder's own architecture.
# $BUILDPLATFORM is the host buildx runs on, not the target — that is the whole
# point of this stage. Do NOT let this inherit TARGETPLATFORM.
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:22.22.2-bookworm-slim AS jsbuilder

WORKDIR /app

# Native modules are not used by Vite or tsc, but `npm install` still runs
# their install scripts. Keep the toolchain so the install doesn't fail.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# PUPPETEER_SKIP_DOWNLOAD=true: puppeteer's postinstall downloads a Chrome
# binary that this image never uses. See the note in the emulated stage below —
# on armv7 it is fatal, here it is merely waste.
RUN --mount=type=cache,target=/root/.npm \
    PUPPETEER_SKIP_DOWNLOAD=true \
    npm install --legacy-peer-deps

# Verify protobufs are present (fail fast if git submodule wasn't initialized)
COPY protobufs ./protobufs
RUN if [ ! -f "protobufs/meshtastic/mesh.proto" ]; then \
      echo "ERROR: Protobuf files not found! Git submodule may not be initialized."; \
      echo "Run: git submodule update --init --recursive"; \
      exit 1; \
    fi

COPY tsconfig.json tsconfig.server.json tsconfig.node.json vite.config.ts index.html embed.html ./
COPY src ./src
COPY public ./public

# Vite clears dist, so the frontend must build before the server build adds to it.
RUN --mount=type=cache,target=/app/node_modules/.vite \
    npm run build
RUN --mount=type=cache,target=/app/.tsc-cache \
    npm run build:server

# ---------------------------------------------------------------------------
# Stage 2 (EMULATED): the only thing that genuinely needs armv7 — node_modules
# with native modules compiled for the target. No application build runs here.
# ---------------------------------------------------------------------------
FROM node:22.22.2-bookworm-slim AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# Kept as a full install (not --omit=dev) so the runtime image contains exactly
# the same node_modules as before this change. Trimming dev dependencies would
# shrink this further — it is the largest remaining emulated cost — but it
# changes what ships, so it belongs in its own change with its own verification.
RUN --mount=type=cache,target=/root/.npm \
    PUPPETEER_SKIP_DOWNLOAD=true \
    npm install --legacy-peer-deps

# ---------------------------------------------------------------------------
# Production stage for ARMv7
# ---------------------------------------------------------------------------
FROM node:22.22.2-bookworm-slim

WORKDIR /app

# Install Python and dependencies for Apprise
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-requests \
    supervisor \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && python3 -m venv /opt/apprise-venv \
    && /opt/apprise-venv/bin/pip install --no-cache-dir apprise "paho-mqtt<2.0"

COPY package*.json ./

# node_modules comes from the EMULATED stage (native modules built for armv7);
# dist and protobufs come from the NATIVE stage. Mixing these up is the one way
# to get a subtly broken image out of this split — dist from the emulated stage
# would merely be slow, but node_modules from the native stage would ship amd64
# better-sqlite3 binaries into an armv7 image.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=jsbuilder /app/dist ./dist
COPY --from=jsbuilder /app/protobufs ./protobufs

# Fix ownership of dist directory for node user
RUN chown -R node:node ./dist

# Create data directory for SQLite database and Apprise configs
RUN mkdir -p /data/apprise-config /data/scripts && chown -R node:node /data

# Create supervisor configuration to run both Node.js and Apprise
RUN mkdir -p /etc/supervisor/conf.d
COPY docker/supervisord.armv7.conf /etc/supervisord.conf

# Create Apprise API wrapper script
COPY docker/apprise-api.py /app/apprise-api.py
RUN chmod +x /app/apprise-api.py

# Copy and set up entrypoint script
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose ports
# 3001: MeshMonitor Express server
# 8000: Internal Apprise API (not exposed to host by default)
EXPOSE 3001 8000

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3001
ENV APPRISE_CONFIG_DIR=/data/apprise-config
ENV APPRISE_STATEFUL_MODE=simple

# Use entrypoint to deploy scripts before starting supervisor
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Run supervisor to manage both processes
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
