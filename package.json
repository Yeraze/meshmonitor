    "prom-client": "^15.1.3",
    "protobufjs": "^8.7.2",
    "qrcode": "^1.5.4",
    "re2": "^1.26.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2",
